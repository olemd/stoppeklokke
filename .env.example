# Local values for `bun run render-config` (scripts/render-wrangler-config.ts).
# `bun run bootstrap` writes .env for you. Secrets (SETUP_TOKEN, VAPID_*) go in
# .dev.vars for local development and in `wrangler secret` for production.
WORKER_NAME=stoppeklokke
ORIGIN=http://localhost:8787
RP_ID=localhost
D1_DATABASE_ID=00000000-0000-0000-0000-000000000000
CUSTOM_DOMAIN=
SOURCE_URL=https://github.com/olemd/stoppeklokke
