# SPDX-License-Identifier: AGPL-3.0-or-later
# Environment for the self-hosted server (docs/self-hosting.md).
# Copy to ~/.config/stoppeklokke/stoppeklokke.env (Quadlet) or .env (bun run start),
# and keep it private: chmod 600.

# Public address and passkey domain (required). RP_ID is the host of ORIGIN.
ORIGIN=https://stoppeklokke.example.com
RP_ID=stoppeklokke.example.com

# One-time token for /setup?token=… (at least 16 characters).
# Generate: openssl rand -base64 24
SETUP_TOKEN=

# Web Push (optional; all three or none). Generate with `bun run vapid` in a checkout.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Addresses of your reverse proxy, as the server sees them (IPs or CIDRs).
# Needed so the login rate limit sees real client addresses. If the server logs
# "X-Forwarded-For from an untrusted address", add the proxy_address it shows.
TRUSTED_PROXIES=127.0.0.1,::1

# Point at your own repository if you run a modified version (AGPL §13).
SOURCE_URL=https://github.com/olemd/stoppeklokke

# Defaults, normally left alone (the container image sets the paths):
# PORT=8787
# HOST=127.0.0.1
# DATABASE_PATH=./data/stoppeklokke.sqlite
# STATIC_DIR=./dist/web
# MIGRATIONS_DIR=./migrations
