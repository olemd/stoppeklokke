{
  "name": "Stoppeklokke",
  "short_name": "Stoppeklokke",
  "description": "Single-user time tracking with a stopwatch, reports and invoicing basis.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f7f8fa",
  "theme_color": "#14181f",
  "lang": "en",
  "dir": "ltr",
  "shortcuts": [
    {
      "name": "Start or stop the timer",
      "short_name": "Start/stop",
      "url": "/?action=toggle",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Add time",
      "short_name": "Add time",
      "url": "/log?new=1",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    {
      "src": "/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    { "src": "/icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ]
}
