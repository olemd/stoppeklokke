// SPDX-License-Identifier: AGPL-3.0-or-later
// Template for wrangler.jsonc, which is NOT committed (§11, fork friendliness).
// Render it with `bun run render-config` (scripts/render-wrangler-config.ts):
// locally from .env / .dev.vars, in CI from GitHub Variables.
// Placeholders (a dollar sign and a braced NAME) are substituted, then the result is parsed as JSONC.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "${WORKER_NAME}",
  "main": "src/platform/cloudflare/worker.ts",
  "compatibility_date": "2026-08-15",
  "workers_dev": true,
  "assets": {
    "directory": "./dist/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "${WORKER_NAME}",
      "database_id": "${D1_DATABASE_ID}",
      "migrations_dir": "migrations",
    },
  ],
  // One cron trigger for the whole app; modules hook into it (§8.1, §15.1).
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "ORIGIN": "${ORIGIN}",
    "RP_ID": "${RP_ID}",
    "RP_NAME": "${RP_NAME}",
    "SOURCE_URL": "${SOURCE_URL}",
    "APP_VERSION": "${APP_VERSION}",
    "GIT_SHA": "${GIT_SHA}",
  },
  "observability": { "enabled": true },
}
